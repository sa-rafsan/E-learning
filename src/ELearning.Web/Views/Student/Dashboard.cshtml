@using System.Security.Claims
@{
    ViewData["Title"] = "Student Dashboard";
    ViewData["HideChrome"] = true;
    var fullName = User.Identity?.Name ?? "Student";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
    var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
        : fullName[..Math.Min(2, fullName.Length)].ToUpperInvariant();
}

<div class="admin-shell">
    <aside class="admin-sidebar">
        <div>
            <div class="admin-sidebar-brand">
                <span class="admin-brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                        <path d="M6 12v5c3 3 9 3 12 0v-5" />
                    </svg>
                </span>
                <div>
                    <div class="fw-bold lh-sm text-white">E-Learning</div>
                    <div class="small text-secondary lh-sm" style="font-size: 0.75rem;">Student Portal</div>
                </div>
            </div>

            <div class="admin-nav-label">MAIN MENU</div>
            <ul class="admin-nav-list">
                <li class="admin-nav-item">
                    <a href="#courseProgressSection" class="admin-nav-link active text-decoration-none">
                        <span>Course Progress</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a href="#activitiesSection" class="admin-nav-link text-decoration-none">
                        <span>Quizzes, Assignments &amp; Forum</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a href="/Student/Attendance" class="admin-nav-link text-decoration-none">
                        <span>My Attendance</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-controller="Courses" asp-action="Index" class="admin-nav-link text-decoration-none">
                        <span>Explore Courses</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a href="/Account/Profile" class="admin-nav-link text-decoration-none">
                        <span>My Profile &amp; Password</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="admin-sidebar-footer">
            <div class="admin-user-pill">
                <span class="admin-avatar">@initials</span>
                <div class="min-w-0 flex-grow-1">
                    <div class="small fw-semibold text-white text-truncate">@fullName</div>
                    <div class="text-info text-truncate" style="font-size: 0.72rem;">@email</div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-link text-secondary p-0" title="Sign Out" aria-label="Sign Out">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div>
                <h1 class="h4 fw-bold mb-0 text-dark">Student Learning Dashboard</h1>
                <p class="text-muted small mb-0">Track your course completion progress and classroom attendance</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="admin-pill-badge">Term: 2026-2027</span>
                <span class="admin-pill-badge">Student</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
                </form>
            </div>
        </header>

        <div class="p-3 p-md-4">
            <!-- Quizzes, Assignments & Forum Overview (Given vs Completed) -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="kpi-card d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-label mb-1">Quizzes</div>
                            <div class="kpi-value mb-0"><span id="stuOverviewQuizzesCompleted">0</span> / <span id="stuOverviewQuizzes">0</span></div>
                            <div class="small text-muted">Completed / Given</div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary px-2 py-1">Quiz</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="kpi-card d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-label mb-1">Assignments</div>
                            <div class="kpi-value mb-0"><span id="stuOverviewAssignmentsCompleted">0</span> / <span id="stuOverviewAssignments">0</span></div>
                            <div class="small text-muted">Completed / Given</div>
                        </div>
                        <span class="badge bg-warning-subtle text-warning-emphasis px-2 py-1">Assignment</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="kpi-card d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-label mb-1">Forum</div>
                            <div class="kpi-value mb-0"><span id="stuOverviewForumsCompleted">0</span> / <span id="stuOverviewForums">0</span></div>
                            <div class="small text-muted">Completed / Given</div>
                        </div>
                        <span class="badge bg-info-subtle text-info-emphasis px-2 py-1">Forum</span>
                    </div>
                </div>
            </div>

            <!-- Attendance Summary Card -->
            <div class="user-table-card p-3 p-md-4 mb-4">
                <div class="mb-3">
                    <h2 class="h5 fw-bold mb-0">Attendance Summary</h2>
                    <p class="text-muted small mb-0">Your presence, late, and absence this month</p>
                </div>
                <div class="row align-items-center g-4">
                    <div class="col-md-5 d-flex justify-content-center">
                        <div class="position-relative d-inline-flex align-items-center justify-content-center" style="width:190px;height:190px;">
                            <svg id="stuAttDonutSvg" width="190" height="190" viewBox="0 0 190 190">
                                <circle cx="95" cy="95" r="74" fill="none" stroke="#e2e8f0" stroke-width="24" />
                            </svg>
                            <div class="position-absolute text-center">
                                <div class="h4 fw-bold mb-0 text-dark" id="stuAttPresentPct">0%</div>
                                <div class="small fw-semibold text-muted" style="font-size:0.7rem;letter-spacing:0.05em;">PRESENT</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-7 d-flex flex-column gap-2">
                        <div class="d-flex justify-content-between align-items-center px-3 py-2 rounded-pill border" style="background:#ecfdf5;border-color:#a7f3d0 !important;">
                            <span class="small fw-semibold text-dark"><span class="me-2" style="color:#059669;">&#9679;</span>Present</span>
                            <span class="small fw-bold" style="color:#059669;" id="stuAttPresentPill">0% (0)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center px-3 py-2 rounded-pill border" style="background:#fffbeb;border-color:#fde68a !important;">
                            <span class="small fw-semibold text-dark"><span class="me-2" style="color:#d97706;">&#9679;</span>Late</span>
                            <span class="small fw-bold" style="color:#d97706;" id="stuAttLatePill">0% (0)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center px-3 py-2 rounded-pill border" style="background:#fef2f2;border-color:#fecaca !important;">
                            <span class="small fw-semibold text-dark"><span class="me-2" style="color:#dc2626;">&#9679;</span>Absent</span>
                            <span class="small fw-bold" style="color:#dc2626;" id="stuAttAbsentPill">0% (0)</span>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Course Completion Overview (Progress & Gauges) -->
            <div class="chart-card mb-4" id="courseProgressSection">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-2 mb-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="kpi-icon-box kpi-icon-blue" style="width:36px;height:36px;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" /></svg>
                        </span>
                        <div>
                            <h2 class="h6 fw-bold mb-0">Course Completion Overview</h2>
                            <div class="text-muted" style="font-size: 0.75rem;">Student &bull; Progress &amp; Gauges</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="analytics-badge" id="courseProgressCountBadge">0 Courses</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Scroll horizontally or click any course card to update completed lessons</span>
                </div>

                <div class="gauge-scroll-row" id="courseGaugesContainer">
                    <div class="text-muted small py-4">Loading course progress...</div>
                </div>
            </div>

            <!-- Quizzes, Assignments & Forum List -->
            <div class="user-table-card p-3 p-md-4 mb-4" id="activitiesSection">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-0">Quizzes, Assignments &amp; Forum</h2>
                        <p class="text-muted small mb-0">Click Open to go directly to any activity.</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Course</th>
                                <th>Week</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="studentActivitiesTableBody">
                            <tr><td colspan="5" class="text-center py-3 text-muted small">Loading activities...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Course Lessons Checklist Modal -->
<div class="modal fade" id="courseLessonsModal" tabindex="-1" aria-labelledby="courseLessonsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 fw-bold" id="courseLessonsModalLabel">Course Lessons</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="courseLessonsModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
            <!-- Quizzes, Assignments & Forum List -->
            <div class="user-table-card p-3 p-md-4 mb-4" id="activitiesSection">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-0">Quizzes, Assignments &amp; Forum</h2>
                        <p class="text-muted small mb-0">Click Open to go directly to any activity.</p>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Course</th>
                                <th>Week</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="studentActivitiesTableBody">
                            <tr><td colspan="5" class="text-center py-3 text-muted small">Loading activities...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/student-attendance.js" asp-append-version="true"></script>
}
