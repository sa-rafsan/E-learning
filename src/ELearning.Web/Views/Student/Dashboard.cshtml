@using System.Security.Claims
@{
    ViewData["Title"] = "Student Dashboard";
    ViewData["HideChrome"] = true;
    var fullName = User.Identity?.Name ?? "Student";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
    var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
        : fullName[..Math.Min(2, fullName.Length)].ToUpperInvariant();
}

<div class="admin-shell">
    <aside class="admin-sidebar">
        <div>
            <div class="admin-sidebar-brand">
                <span class="admin-brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                        <path d="M6 12v5c3 3 9 3 12 0v-5" />
                    </svg>
                </span>
                <div>
                    <div class="fw-bold lh-sm text-white">E-Learning</div>
                    <div class="small text-secondary lh-sm" style="font-size: 0.75rem;">Student Portal</div>
                </div>
            </div>

            <div class="admin-nav-label">MAIN MENU</div>
            <ul class="admin-nav-list">
                <li class="admin-nav-item">
                    <a href="#courseProgressSection" class="admin-nav-link active text-decoration-none">
                        <span>Course Progress</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a href="#attendanceHistorySection" class="admin-nav-link text-decoration-none">
                        <span>My Attendance</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a asp-controller="Courses" asp-action="Index" class="admin-nav-link text-decoration-none">
                        <span>Explore Courses</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a href="/Account/Profile" class="admin-nav-link text-decoration-none">
                        <span>My Profile &amp; Password</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="admin-sidebar-footer">
            <div class="admin-user-pill">
                <span class="admin-avatar">@initials</span>
                <div class="min-w-0 flex-grow-1">
                    <div class="small fw-semibold text-white text-truncate">@fullName</div>
                    <div class="text-info text-truncate" style="font-size: 0.72rem;">@email</div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-link text-secondary p-0" title="Sign Out" aria-label="Sign Out">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <div>
                <h1 class="h4 fw-bold mb-0 text-dark">Student Learning Dashboard</h1>
                <p class="text-muted small mb-0">Track your course completion progress and classroom attendance</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="admin-pill-badge">Term: 2026-2027</span>
                <span class="admin-pill-badge">Student</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
                </form>
            </div>
        </header>

        <div class="p-3 p-md-4">
            <!-- Course Completion Overview (Progress & Gauges) -->
            <div class="chart-card mb-4" id="courseProgressSection">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-2 mb-3 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="kpi-icon-box kpi-icon-blue" style="width:36px;height:36px;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" /></svg>
                        </span>
                        <div>
                            <h2 class="h6 fw-bold mb-0">Course Completion Overview</h2>
                            <div class="text-muted" style="font-size: 0.75rem;">Student &bull; Progress &amp; Gauges</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="analytics-badge" id="courseProgressCountBadge">0 Courses</span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-muted">Scroll horizontally or click any course card to update completed lessons</span>
                </div>

                <div class="gauge-scroll-row" id="courseGaugesContainer">
                    <div class="text-muted small py-4">Loading course progress...</div>
                </div>
            </div>

            <!-- Enrolled Courses & Weekly Workspaces -->
            <div class="user-table-card p-3 p-md-4 mb-4">
                <h2 class="h6 fw-bold mb-1">My Enrolled Courses &amp; Workspaces</h2>
                <p class="text-muted small mb-3">Open any course to view General info, Teachers, Weekly Topics, Assignments, Quizzes, Forums &amp; Exams.</p>
                <div class="row g-2" id="studentWorkspaceCoursesRow">
                    <div class="col-12 text-muted small">Loading courses...</div>
                </div>
            </div>

            <!-- My Attendance Record -->
            <div class="user-table-card p-3 p-md-4" id="attendanceHistorySection">
                <h2 class="h5 fw-bold mb-3">My Attendance Record</h2>
                <div class="table-responsive">
                    <table class="table table-hover align-middle dir-table mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Course</th>
                                <th>Teacher</th>
                                <th>Topic</th>
                                <th>Status</th>
                                <th>Remarks</th>
                            </tr>
                        </thead>
                        <tbody id="studentAttendanceBody">
                            <tr>
                                <td colspan="6" class="text-center py-3 text-muted">Loading attendance...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Course Lessons Checklist Modal -->
<div class="modal fade" id="courseLessonsModal" tabindex="-1" aria-labelledby="courseLessonsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 fw-bold" id="courseLessonsModalLabel">Course Lessons</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="courseLessonsModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/student-attendance.js" asp-append-version="true"></script>
}
