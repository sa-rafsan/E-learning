@using System.Security.Claims
@{
    ViewData["Title"] = "Classroom Attendance System";
    ViewData["HideChrome"] = true;
    var fullName = User.Identity?.Name ?? "Teacher";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
    var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
        : fullName[..Math.Min(2, fullName.Length)].ToUpperInvariant();
}

<div class="admin-shell">
    <!-- Left Dark Navy Sidebar -->
    <aside class="admin-sidebar">
        <div>
            <div class="admin-sidebar-brand">
                <span class="admin-brand-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                        <path d="M6 12v5c3 3 9 3 12 0v-5" />
                    </svg>
                </span>
                <div>
                    <div class="fw-bold lh-sm text-white">E-Learning</div>
                    <div class="small text-secondary lh-sm" style="font-size: 0.75rem;">Attendance System</div>
                </div>
            </div>

            <div class="admin-nav-label">MAIN MENU</div>
            <ul class="admin-nav-list">
                <li class="admin-nav-item">
                    <button type="button" class="admin-nav-link active" data-att-tab="mark">
                        <span>Attendance Roster</span>
                    </button>
                </li>
                <li class="admin-nav-item">
                    <button type="button" class="admin-nav-link" data-att-tab="logs">
                        <span>Session Logs</span>
                    </button>
                </li>
                <li class="admin-nav-item">
                    <a asp-controller="Courses" asp-action="Index" class="admin-nav-link text-decoration-none">
                        <span>Browse Courses</span>
                    </a>
                </li>
                <li class="admin-nav-item">
                    <a href="/Account/Profile" class="admin-nav-link text-decoration-none">
                        <span>My Profile &amp; Password</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="admin-sidebar-footer">
            <div class="admin-user-pill">
                <span class="admin-avatar">@initials</span>
                <div class="min-w-0 flex-grow-1">
                    <div class="small fw-semibold text-white text-truncate">@fullName</div>
                    <div class="text-info text-truncate" style="font-size: 0.72rem;">@email</div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-link text-secondary p-0" title="Sign Out" aria-label="Sign Out">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="admin-main">
        <header class="admin-topbar">
            <div>
                <h1 class="h4 fw-bold mb-0 text-dark">Classroom Attendance System</h1>
                <p class="text-muted small mb-0">Teacher marking, session logs, and attendance rate calculation</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="admin-pill-badge">Term: 2026-2027</span>
                <span class="admin-pill-badge">Teacher</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
                </form>
            </div>
        </header>

        <!-- Sub-navigation Tabs -->
        <div class="bg-white border-bottom px-4 d-flex gap-2">
            <button type="button" class="att-tab-btn active" data-att-tab="mark">Mark Attendance</button>
            <button type="button" class="att-tab-btn" data-att-tab="logs">Session Logs</button>
        </div>

        <div class="p-3 p-md-4">
            <div id="attendanceAlertContainer" class="mb-3"></div>

            <!-- Mark Attendance Tab -->
            <div id="tabMarkAttendance">
                <div class="user-table-card p-3 p-md-4 mb-3">
                    <div class="mb-3">
                        <h2 class="h6 fw-bold mb-0 text-dark">Classroom Session Details</h2>
                        <p class="text-muted small mb-0">Select the target course, batch, section, and date to populate the active student roster.</p>
                    </div>

                    <form id="rosterFilterForm" class="row g-2 align-items-end" novalidate>
                        <div class="col-md-3">
                            <label for="rosterCourse" class="form-label small fw-semibold">Subject / Course Name <span class="text-danger">*</span></label>
                            <select id="rosterCourse" class="form-select"></select>
                        </div>
                        <div class="col-md-2">
                            <label for="rosterBatch" class="form-label small fw-semibold">Batch <span class="text-danger">*</span></label>
                            <input type="text" id="rosterBatch" class="form-control" value="70" />
                        </div>
                        <div class="col-md-2">
                            <label for="rosterSection" class="form-label small fw-semibold">Section <span class="text-danger">*</span></label>
                            <select id="rosterSection" class="form-select">
                                <option value="A">Section A</option>
                                <option value="B">Section B</option>
                                <option value="C">Section C</option>
                                <option value="D">Section D</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label for="rosterDate" class="form-label small fw-semibold">Date <span class="text-danger">*</span></label>
                            <input type="date" id="rosterDate" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-primary w-100 fw-semibold">Load Roster</button>
                        </div>
                    </form>

                    <div id="rosterTopicRow" class="row g-2 align-items-center mt-2 d-none">
                        <div class="col-md-6">
                            <input type="text" id="rosterTopic" class="form-control form-control-sm" placeholder="Session topic (optional), e.g. Week 4 - API Security" />
                        </div>
                    </div>
                </div>

                <!-- Roster Card -->
                <div class="user-table-card p-3 p-md-4">
                    <div id="rosterSummaryBar" class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom d-none">
                        <div class="d-flex flex-wrap align-items-center gap-2 small">
                            <span>Roster: <span class="badge bg-light text-dark border" id="countTotal">0</span></span>
                            <span>Present: <span class="badge bg-success-subtle text-success" id="countPresent">0</span></span>
                            <span>Late: <span class="badge bg-warning-subtle text-warning-emphasis" id="countLate">0</span></span>
                            <span>Absent: <span class="badge bg-danger-subtle text-danger" id="countAbsent">0</span></span>
                            <span>Excused: <span class="badge bg-info-subtle text-info-emphasis" id="countExcused">0</span></span>
                            <span>Attendance Rate: <span class="badge bg-primary-subtle text-primary" id="attendanceRateBadge">0%</span></span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" id="markAllPresentBtn" class="btn btn-outline-success btn-sm">Mark All Present</button>
                            <button type="button" id="markAllAbsentBtn" class="btn btn-outline-danger btn-sm">Mark All Absent</button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle dir-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Student Name &amp; ID</th>
                                    <th>Batch / Section</th>
                                    <th>Mark Status</th>
                                    <th>Teacher Remarks</th>
                                </tr>
                            </thead>
                            <tbody id="rosterTableBody">
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">
                                        Select filters and click <strong>Load Roster</strong> to view students.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div id="saveRosterFooter" class="d-flex justify-content-end pt-3 mt-3 border-top d-none">
                        <button type="button" id="saveAttendanceBtn" class="btn btn-primary px-4 fw-semibold">Save Attendance Session</button>
                    </div>
                </div>
            </div>

            <!-- Session Logs Tab -->
            <div id="tabSessionLogs" class="d-none">
                <div class="user-table-card p-3 p-md-4">
                    <h2 class="h5 fw-bold mb-3">Session Logs</h2>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle dir-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Date</th>
                                    <th>Course</th>
                                    <th>Batch / Section</th>
                                    <th>Topic</th>
                                    <th>Summary</th>
                                </tr>
                            </thead>
                            <tbody id="sessionsHistoryBody">
                                <tr>
                                    <td colspan="5" class="text-center py-3 text-muted">Loading sessions...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/teacher-attendance.js" asp-append-version="true"></script>
}
