@{
    ViewData["Title"] = "Sign In";
}

<section class="auth-wrapper">
    <div class="auth-split-card row g-0">
        <!-- Left Dark Navy Info Panel -->
        <div class="col-lg-5 auth-hero-panel p-4 p-md-5">
            <div>
                <div class="d-flex align-items-center gap-2 mb-4">
                    <span class="auth-hero-logo">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                            <path d="M6 12v5c3 3 9 3 12 0v-5" />
                        </svg>
                    </span>
                    <span class="fw-bold fs-5">E-Learning LMS</span>
                </div>

                <h1 class="h3 fw-bold mb-3 lh-sm">Modern Academic &amp; Learning Operations</h1>
                <p class="auth-hero-copy mb-4">
                    A secure, role-based Learning Management System built with ASP.NET Core MVC, Entity Framework Core, Identity, and JWT Authentication.
                </p>

                <ul class="auth-feature-list">
                    <li>
                        <span class="auth-feature-check" aria-hidden="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                        <span>Role-Based Admin, Teacher &amp; Student Portals</span>
                    </li>
                    <li>
                        <span class="auth-feature-check" aria-hidden="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                        <span>Course Management &amp; Batch Enrollments</span>
                    </li>
                    <li>
                        <span class="auth-feature-check" aria-hidden="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                        <span>Real-Time Attendance Roster Tracking</span>
                    </li>
                    <li>
                        <span class="auth-feature-check" aria-hidden="true">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                        </span>
                        <span>Secure Cryptographic Password Protection</span>
                    </li>
                </ul>
            </div>

            <div class="auth-hero-footer pt-3 mt-4">
                &copy; @DateTime.UtcNow.Year E-Learning Platform
            </div>
        </div>

        <!-- Right Sign-In Form Panel -->
        <div class="col-lg-7 p-4 p-md-5 bg-white">
            <div class="mb-4">
                <h2 class="h3 fw-bold mb-1 text-dark">Welcome back</h2>
                <p class="text-muted small mb-0">Please enter your credentials to access the portal.</p>
            </div>

            <div id="loginErrorAlert" class="alert alert-danger d-none py-2 small" role="alert"></div>

            <form id="loginForm" novalidate>
                <!-- Role Selection Box -->
                <div class="auth-role-box mb-3" id="loginRoleBox">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-uppercase text-secondary" style="letter-spacing: 0.04em;">
                            Select Role <span class="text-danger">*</span>
                        </span>
                        <span class="small text-muted">One-Click Autofill</span>
                    </div>

                    <select id="loginRole" name="Role" class="d-none" aria-label="Select Role">
                        <option value="">-- Select Role --</option>
                        <option value="Admin">Admin</option>
                        <option value="Teacher">Teacher</option>
                        <option value="Student">Student</option>
                    </select>

                    <div class="row g-2">
                        <div class="col-6">
                            <button type="button" class="auth-role-btn" data-role="Admin">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                                <span>Admin</span>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="auth-role-btn" data-role="Teacher">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                                <span>Teacher</span>
                            </button>
                        </div>
                        <div class="col-12">
                            <button type="button" class="auth-role-btn" data-role="Student">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
                                <span>Student</span>
                            </button>
                        </div>
                    </div>
                    <div class="text-danger small mt-1" id="loginRoleError"></div>
                </div>

                <!-- Email Address -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <label for="loginEmail" class="form-label small fw-semibold text-dark">Email Address</label>
                        <span class="text-danger small">*</span>
                    </div>
                    <div class="input-group auth-input-group has-validation">
                        <span class="input-group-text">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
                        </span>
                        <input type="email"
                               id="loginEmail"
                               name="Email"
                               class="form-control"
                               placeholder="name@example.com"
                               autocomplete="username" />
                        <div class="invalid-feedback" id="loginEmailError"></div>
                    </div>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <label for="loginPassword" class="form-label small fw-semibold text-dark">Password</label>
                        <span class="text-danger small">*</span>
                    </div>
                    <div class="input-group auth-input-group has-validation">
                        <span class="input-group-text">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                        </span>
                        <input type="password"
                               id="loginPassword"
                               name="Password"
                               class="form-control border-end-0"
                               placeholder="Enter your password"
                               autocomplete="current-password" />
                        <button type="button"
                                id="togglePasswordBtn"
                                class="btn btn-outline-secondary border-start-0 bg-white text-muted"
                                style="border-color: #ced4da;"
                                aria-label="Show password">
                            Show
                        </button>
                        <div class="invalid-feedback" id="loginPasswordError"></div>
                    </div>
                </div>

                <!-- Remember Me -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe" name="RememberMe" />
                        <label class="form-check-label small text-muted" for="rememberMe">Remember Me</label>
                    </div>
                </div>

                <button type="submit" id="loginSubmitBtn" class="btn btn-auth-primary w-100">
                    <span id="loginSpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                    <span id="loginBtnText">Sign In to Dashboard</span>
                </button>

                <p class="text-center text-muted small mt-3 mb-0">
                    Accounts are provisioned by your Administrator.
                </p>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/login.js" asp-append-version="true"></script>
}
