@model IReadOnlyList<CourseSummaryDto>
@{
    ViewData["Title"] = "Learn something new";
}

<section class="hero">
    <div class="hero-copy">
        <p class="eyebrow">A little progress, every day</p>
        <h1>Make room for<br /><span>what's next.</span></h1>
        <p class="hero-description">Practical courses, thoughtful instructors, and a learning space that moves at your pace.</p>
        <a class="button button-light" asp-controller="Courses" asp-action="Index">Explore all courses <span aria-hidden="true">&rarr;</span></a>
        <div class="hero-note"><span class="status-dot"></span> Your next idea starts here</div>
    </div>
    <div class="hero-art" aria-hidden="true">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="hero-card">
            <div class="hero-card-top"><span class="tiny-mark">E</span><span>YOUR LEARNING SPACE</span></div>
            <div class="hero-card-line"></div>
            <div class="hero-card-title">Curiosity<br />looks good<br /><em>on you.</em></div>
            <div class="hero-card-bottom"><span>01 — BEGIN ANYWHERE</span><span class="arrow-circle">&rarr;</span></div>
        </div>
        <div class="floating-note"><span class="note-icon">+</span><span>Small steps.<br /><strong>Big shifts.</strong></span></div>
    </div>
</section>

<section class="section-block">
    <div class="section-heading">
        <div>
            <p class="eyebrow">A good place to begin</p>
            <h2>Find your next thing.</h2>
        </div>
        <a class="text-link" asp-controller="Courses" asp-action="Index">View all courses <span aria-hidden="true">&rarr;</span></a>
    </div>

    @if (Model.Count == 0)
    {
        <p class="empty-state">New courses are on the way. Check back soon.</p>
    }
    else
    {
        <div class="course-grid">
            @foreach (var course in Model)
            {
                <partial name="_CourseCard" model="course" />
            }
        </div>
    }
</section>

<section class="bottom-banner">
    <p class="eyebrow">Learning is a practice</p>
    <p>Start where you are. Build from there.</p>
    <a class="button button-dark" asp-controller="Courses" asp-action="Index">Browse the catalog <span aria-hidden="true">&rarr;</span></a>
</section>
