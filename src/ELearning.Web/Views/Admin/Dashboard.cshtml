@{
    ViewData["Title"] = "Academic Dashboard";
    ViewData["HideChrome"] = true;
    ViewData["ActiveMenu"] = "Dashboard";
}

<div class="admin-shell">
    @await Html.PartialAsync("_AdminSidebar")

    <!-- Main Content Area -->
    <div class="admin-main">
        <!-- Top Header Bar -->
        <header class="admin-topbar">
            <div>
                <h1 class="h4 fw-bold mb-0 text-dark">Academic Dashboard</h1>
                <p class="text-muted small mb-0">Overview of university enrollment, courses, and user metrics</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="admin-pill-badge">Term: 2026-2027</span>
                <span class="admin-pill-badge">Admin</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
                </form>
            </div>
        </header>

        <div class="p-3 p-md-4">
            <div id="adminToastContainer" class="admin-toast-container" aria-live="polite"></div>
            <div id="adminAlertContainer" class="mb-3"></div>

            <!-- 5 KPI Cards Row -->
            <div class="row g-3 mb-4" id="sectionOverview">
                <div class="col-sm-6 col-xl">
                    <div class="kpi-card d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-label mb-2">Total Users</div>
                            <div class="kpi-value mb-1" id="statTotalUsers">0</div>
                            <div class="small text-success fw-medium">All registered accounts</div>
                        </div>
                        <span class="kpi-icon-box kpi-icon-blue">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                        </span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl">
                    <div class="kpi-card d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-label mb-2">Active Accounts</div>
                            <div class="kpi-value mb-1" id="statActiveUsers">0</div>
                            <div class="small text-success fw-medium">Verified active status</div>
                        </div>
                        <span class="kpi-icon-box kpi-icon-green">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><polyline points="17 11 19 13 23 9" /></svg>
                        </span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl">
                    <div class="kpi-card d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-label mb-2">Students</div>
                            <div class="kpi-value mb-1" id="statStudents">0</div>
                            <div class="small text-muted">Batch 70 enrollments</div>
                        </div>
                        <span class="kpi-icon-box kpi-icon-amber">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
                        </span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl">
                    <div class="kpi-card d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-label mb-2">Teachers</div>
                            <div class="kpi-value mb-1" id="statTeachers">0</div>
                            <div class="small text-muted">Active faculty</div>
                        </div>
                        <span class="kpi-icon-box kpi-icon-purple">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
                        </span>
                    </div>
                </div>
                <div class="col-sm-6 col-xl">
                    <div class="kpi-card d-flex justify-content-between align-items-start">
                        <div>
                            <div class="kpi-label mb-2">Total Courses</div>
                            <div class="kpi-value mb-1" id="statCourses">0</div>
                            <div class="small text-success fw-medium">Published &amp; assigned</div>
                        </div>
                        <span class="kpi-icon-box kpi-icon-teal">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" /><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" /></svg>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Multi-Chart Analytics Grid (3 + 2 Layout) -->
            <div id="sectionCharts">
                <div class="row g-3 mb-3">
                    <!-- Chart 1: Attendance Distribution Donut -->
                    <div class="col-lg-4">
                        <div class="chart-card">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h2 class="h6 fw-bold mb-0">Attendance Distribution</h2>
                                    <div class="text-muted" style="font-size: 0.75rem;">Classroom &bull; Live Analytics</div>
                                </div>
                                <span class="analytics-badge">Live</span>
                            </div>
                            <div class="row g-2 align-items-center">
                                <div class="col-5 d-flex justify-content-center" id="chartAttendanceDonut"></div>
                                <div class="col-7" id="chartAttendanceLegend"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Chart 2: Batch 70 Section Active vs Inactive Bar Chart -->
                    <div class="col-lg-4">
                        <div class="chart-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h2 class="h6 fw-bold mb-0">Section Active vs Inactive</h2>
                                    <div class="text-muted" style="font-size: 0.75rem;">Batch 70 &bull; Section Breakdown</div>
                                </div>
                                <span class="analytics-badge">Sections</span>
                            </div>
                            <div class="grouped-bar-area" id="chartSectionGroupedBars"></div>
                            <div class="d-flex justify-content-center gap-3 small text-muted mt-2">
                                <span><span style="color:#10b981;">&#9632;</span> Active</span>
                                <span><span style="color:#ef4444;">&#9632;</span> Inactive</span>
                            </div>
                        </div>
                    </div>

                    <!-- Chart 3: Role & Account Breakdown Donut -->
                    <div class="col-lg-4">
                        <div class="chart-card">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h2 class="h6 fw-bold mb-0">Role &amp; Account Analysis</h2>
                                    <div class="text-muted" style="font-size: 0.75rem;">Directory &bull; Role Breakdown</div>
                                </div>
                                <span class="analytics-badge">Users</span>
                            </div>
                            <div class="row g-2 align-items-center">
                                <div class="col-5 d-flex justify-content-center" id="chartRoleDonut"></div>
                                <div class="col-7" id="chartRoleBreakdown"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <!-- Chart 4: Academic & Course Pipeline (2x2 Tiles) -->
                    <div class="col-lg-6">
                        <div class="chart-card">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h2 class="h6 fw-bold mb-0">Academic Operations Pipeline</h2>
                                    <div class="text-muted" style="font-size: 0.75rem;">Courses &bull; Assignments &amp; Sessions</div>
                                </div>
                                <span class="analytics-badge">Metrics</span>
                            </div>
                            <div class="row g-2" id="chartAcademicPipeline"></div>
                        </div>
                    </div>

                    <!-- Chart 5: Course Enrollment Area Trend -->
                    <div class="col-lg-6">
                        <div class="chart-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h2 class="h6 fw-bold mb-0">Course Enrollment &amp; Duration Trend</h2>
                                    <div class="text-muted" style="font-size: 0.75rem;">Courses &bull; Area Analytics</div>
                                </div>
                                <span class="analytics-badge">Area</span>
                            </div>
                            <div id="chartCourseAreaTrend"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Courses & Assignments Table -->
            <div class="user-table-card p-3 p-md-4 mb-4 d-none" id="sectionCourses">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-0">Course List &amp; Assignments</h2>
                        <p class="text-muted small mb-0">Create courses and assign Teachers and Students.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" id="refreshCoursesBtn" class="btn btn-outline-secondary btn-sm">Refresh</button>
                        <button type="button" class="btn btn-primary btn-sm" id="openCreateCourseBtn">+ Add Course</button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Course Title</th>
                                <th>Code / Weeks</th>
                                <th>Category</th>
                                <th>Batches</th>
                                <th>Assigned Teacher</th>
                                <th>Enrolled</th>
                                <th class="text-end">Actions &amp; Batches</th>
                            </tr>
                        </thead>
                        <tbody id="coursesTableBody">
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Loading courses...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Settings: Batches & Departments Master Data Section -->
            <div id="sectionBatchesDepartments" class="d-none">
                <div id="masterDataAlert" class="mb-3"></div>
                <div class="row g-4 mb-4">
                    <!-- Departments Card -->
                    <div class="col-lg-6">
                        <div class="user-table-card p-3 p-md-4 h-100">
                            <div class="mb-3">
                                <h2 class="h5 fw-bold mb-0">Departments</h2>
                                <p class="text-muted small mb-0">Create and edit departments; this list populates department dropdowns across the portal.</p>
                            </div>
                            <form id="createDepartmentForm" class="row g-2 align-items-end mb-3 p-3 bg-light rounded border">
                                <input type="hidden" id="editDeptId" />
                                <div class="col-sm-6">
                                    <label for="deptNameInput" class="form-label small fw-semibold mb-1">Department Name *</label>
                                    <input type="text" class="form-control form-control-sm" id="deptNameInput" placeholder="e.g. Computer Science" required />
                                </div>
                                <div class="col-sm-3">
                                    <label for="deptCodeInput" class="form-label small fw-semibold mb-1">Code *</label>
                                    <input type="text" class="form-control form-control-sm" id="deptCodeInput" placeholder="e.g. CSE" required />
                                </div>
                                <div class="col-sm-3 d-flex gap-1">
                                    <button type="submit" class="btn btn-primary btn-sm w-100" id="deptSubmitBtn">+ Add</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="deptCancelEditBtn">Cancel</button>
                                </div>
                            </form>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Department Name</th>
                                            <th>Code</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="departmentsTableBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Batches Card -->
                    <div class="col-lg-6">
                        <div class="user-table-card p-3 p-md-4 h-100">
                            <div class="mb-3">
                                <h2 class="h5 fw-bold mb-0">Batches</h2>
                                <p class="text-muted small mb-0">Create and edit batches with sections (A, B, C, D).</p>
                            </div>
                            <form id="createMasterBatchForm" class="row g-2 align-items-end mb-3 p-3 bg-light rounded border">
                                <input type="hidden" id="editMasterBatchId" />
                                <div class="col-sm-6">
                                    <label for="masterBatchNameInput" class="form-label small fw-semibold mb-1">Batch Name *</label>
                                    <input type="text" class="form-control form-control-sm" id="masterBatchNameInput" placeholder="e.g. Batch 70" required />
                                </div>
                                <div class="col-sm-3">
                                    <label for="masterBatchCodeInput" class="form-label small fw-semibold mb-1">Code *</label>
                                    <input type="text" class="form-control form-control-sm" id="masterBatchCodeInput" placeholder="e.g. B70" required />
                                </div>
                                <div class="col-sm-3 d-flex gap-1">
                                    <button type="submit" class="btn btn-primary btn-sm w-100" id="masterBatchSubmitBtn">+ Add</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="masterBatchCancelEditBtn">Cancel</button>
                                </div>
                                <div class="col-12 mt-2">
                                    <label class="form-label small fw-semibold mb-1">Sections</label>
                                    <div class="dropdown" id="masterBatchSectionsDropdown">
                                        <button class="btn btn-sm btn-outline-secondary bg-white text-dark dropdown-toggle w-100 text-start d-flex justify-content-between align-items-center" type="button" id="masterBatchSectionsBtn" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                            <span id="masterBatchSectionsLabel" class="text-truncate">Select Sections...</span>
                                        </button>
                                        <div class="dropdown-menu w-100 p-2 shadow-sm" id="masterBatchSectionsMenu" style="max-height: 200px; overflow-y: auto;"></div>
                                    </div>
                                </div>
                            </form>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Batch Name</th>
                                            <th>Code</th>
                                            <th>Sections</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="masterBatchesTableBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Sections Card -->
                    <div class="col-lg-6">
                        <div class="user-table-card p-3 p-md-4 h-100">
                            <div class="mb-3">
                                <h2 class="h5 fw-bold mb-0">Sections</h2>
                                <p class="text-muted small mb-0">Create and edit sections (e.g. A, B, C, D); they appear in the Batch sections dropdown.</p>
                            </div>
                            <form id="createSectionForm" class="row g-2 align-items-end mb-3 p-3 bg-light rounded border">
                                <input type="hidden" id="editSectionId" />
                                <div class="col-sm-8">
                                    <label for="sectionNameInput" class="form-label small fw-semibold mb-1">Section Name *</label>
                                    <input type="text" class="form-control form-control-sm" id="sectionNameInput" placeholder="e.g. A" required />
                                </div>
                                <div class="col-sm-4 d-flex gap-1">
                                    <button type="submit" class="btn btn-primary btn-sm w-100" id="sectionSubmitBtn">+ Add</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="sectionCancelEditBtn">Cancel</button>
                                </div>
                            </form>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Section Name</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="masterSectionsTableBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Semesters Card -->
                    <div class="col-lg-6">
                        <div class="user-table-card p-3 p-md-4 h-100">
                            <div class="mb-3">
                                <h2 class="h5 fw-bold mb-0">Semesters</h2>
                                <p class="text-muted small mb-0">Manage semesters (default 1st–10th Semester seeded); populates student semester dropdowns.</p>
                            </div>
                            <form id="createSemesterForm" class="row g-2 align-items-end mb-3 p-3 bg-light rounded border">
                                <input type="hidden" id="editSemesterId" />
                                <div class="col-sm-8">
                                    <label for="semesterNameInput" class="form-label small fw-semibold mb-1">Semester Name *</label>
                                    <input type="text" class="form-control form-control-sm" id="semesterNameInput" placeholder="e.g. 11th Semester" required />
                                </div>
                                <div class="col-sm-4 d-flex gap-1">
                                    <button type="submit" class="btn btn-primary btn-sm w-100" id="semesterSubmitBtn">+ Add</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm d-none" id="semesterCancelEditBtn">Cancel</button>
                                </div>
                            </form>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Semester Name</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="masterSemestersTableBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Separate Teacher List Section -->
            <div id="sectionTeachers" class="d-none">
                <div class="user-table-card p-3 mb-3">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                        <div>
                            <h2 class="h5 fw-bold mb-0">Teacher List</h2>
                            <p class="text-muted small mb-0">Manage faculty accounts, status, and credentials.</p>
                        </div>
                        <button type="button" class="btn btn-primary btn-sm" id="openCreateTeacherBtn">+ Add Teacher</button>
                    </div>
                    <div class="row g-2 align-items-center">
                        <div class="col-md-6">
                            <input type="search" id="teacherSearchInput" class="form-control" placeholder="Search teachers by name, email, or phone..." />
                        </div>
                        <div class="col-md-4">
                            <select id="teacherStatusFilter" class="form-select">
                                <option value="">All Statuses</option>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="button" id="resetTeacherFiltersBtn" class="btn btn-outline-secondary w-100">Reset</button>
                        </div>
                    </div>
                </div>

                <div class="user-table-card p-3 p-md-4 mb-4">
                    <div class="small text-muted mb-3">
                        Total Teachers: <strong class="text-dark" id="teachersTotalCount">0</strong>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle dir-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Teacher Details</th>
                                    <th>Contact Info</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="teachersTableBody">
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Loading teachers...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Add New Student Section -->
            <div id="sectionAddStudent" class="d-none">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h2 class="h4 fw-bold mb-0 text-dark">Add New Student</h2>
                        <p class="text-muted small mb-0">Enter complete student personal, contact, and academic details</p>
                    </div>
                    <button type="button" id="backToDirectoryBtn" class="btn btn-outline-secondary btn-sm">
                        &larr; Back to Directory
                    </button>
                </div>

                <form id="createStudentForm" novalidate>
                    <div id="createStudentFormError" class="alert alert-danger d-none"></div>

                    <!-- Card 1: Student Identification & Status -->
                    <div class="user-table-card p-3 p-md-4 mb-3">
                        <div class="mb-3">
                            <h3 class="h6 fw-bold mb-0 text-dark">Student Identification &amp; Status</h3>
                            <p class="text-muted small mb-0">Unique registration ID, department/batch assignment, and active status.</p>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label for="studentIdInput" class="form-label small fw-semibold">Student ID <span class="text-muted fw-normal">(Auto-generated)</span></label>
                                <input type="text" class="form-control bg-light" id="studentIdInput" name="StudentId" placeholder="YYYYMMDD + 0001" readonly />
                                <div class="invalid-feedback" id="studentIdInputError"></div>
                            </div>
                            <div class="col-md-3">
                                <label for="studentDepartment" class="form-label small fw-semibold">Department</label>
                                <select class="form-select" id="studentDepartment" name="Department">
                                    <option value="">Select Department...</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="studentBatch" class="form-label small fw-semibold">Batch</label>
                                <select class="form-select" id="studentBatch" name="Batch">
                                    <option value="">Select Batch...</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label for="studentSection" class="form-label small fw-semibold">Section</label>
                                <select class="form-select" id="studentSection" name="Section">
                                    <option value="">Select Section...</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">Student Status <span class="text-danger">*</span></label>
                                <input type="hidden" id="studentStatus" name="Status" value="1" />
                                <div class="row g-2">
                                    <div class="col-6">
                                        <button type="button" class="status-pill-btn active-status" data-status-val="1">Active Student</button>
                                    </div>
                                    <div class="col-6">
                                        <button type="button" class="status-pill-btn" data-status-val="2">Inactive</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Card 2: Personal Information & Photo -->
                    <div class="user-table-card p-3 p-md-4 mb-3">
                        <div class="mb-3">
                            <h3 class="h6 fw-bold mb-0 text-dark">Personal Information &amp; Photo</h3>
                            <p class="text-muted small mb-0">Personal identity, date of birth, gender, and student profile picture.</p>
                        </div>
                        <div class="p-3 mb-3 rounded border border-dashed bg-light d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-secondary-subtle d-flex align-items-center justify-content-center text-secondary fw-bold" style="width:56px;height:56px;" id="studentPhotoPreview">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <div>
                                <label for="studentPhotoInput" class="btn btn-sm btn-outline-secondary mb-1">Upload Image</label>
                                <input type="file" id="studentPhotoInput" class="d-none" accept="image/png,image/jpeg,image/webp" />
