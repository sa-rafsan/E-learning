                            <option value="2">Inactive</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View User Details Modal -->
<div class="modal fade" id="viewUserModal" tabindex="-1" aria-labelledby="viewUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 fw-bold" id="viewUserModalLabel">User Details</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="viewUserModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="resetPasswordForm" novalidate>
                <input type="hidden" id="resetPasswordUserId" />
                <div class="modal-header">
                    <h2 class="modal-title h5 fw-bold" id="resetPasswordModalLabel">Reset User Password</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="resetPasswordFormError" class="alert alert-danger d-none"></div>
                    <p class="small text-muted">Resetting password for <strong id="resetPasswordUserName"></strong>.</p>
                    <div class="mb-3">
                        <label for="resetNewPassword" class="form-label">New Password *</label>
                        <input type="password" class="form-control" id="resetNewPassword" />
                        <div class="invalid-feedback" id="resetNewPasswordError"></div>
                    </div>
                    <div class="mb-2">
                        <label for="resetConfirmPassword" class="form-label">Confirm Password *</label>
                        <input type="password" class="form-control" id="resetConfirmPassword" />
                        <div class="invalid-feedback" id="resetConfirmPasswordError"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Create Course Modal -->
<div class="modal fade" id="createCourseModal" tabindex="-1" aria-labelledby="createCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createCourseForm" novalidate>
                <div class="modal-header">
                    <h2 class="modal-title h5 fw-bold" id="createCourseModalLabel">Add New Course</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="createCourseFormError" class="alert alert-danger d-none"></div>
                    <div class="mb-3">
                        <label for="courseTitle" class="form-label">Course Title *</label>
                        <input type="text" class="form-control" id="courseTitle" />
                        <div class="invalid-feedback" id="courseTitleError"></div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label for="courseCategory" class="form-label">Category *</label>
                            <input type="text" class="form-control" id="courseCategory" placeholder="e.g. Development" />
                            <div class="invalid-feedback" id="courseCategoryError"></div>
                        </div>
                        <div class="col-md-6">
                            <label for="courseDuration" class="form-label">Duration (Hours) *</label>
                            <input type="number" class="form-control" id="courseDuration" min="1" value="6" />
                            <div class="invalid-feedback" id="courseDurationError"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="courseTeacher" class="form-label">Assign Teacher (Optional)</label>
                        <select class="form-select" id="courseTeacher">
                            <option value="">-- Assign Later --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="courseDescription" class="form-label">Description *</label>
                        <textarea class="form-control" id="courseDescription" rows="3"></textarea>
                        <div class="invalid-feedback" id="courseDescriptionError"></div>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="courseIsPublished" checked />
                        <label class="form-check-label" for="courseIsPublished">Published</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Course</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Manage Batches Modal -->
<div class="modal fade" id="manageBatchesModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5 fw-bold">Course Batches &amp; Multi-Teacher Assignment</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="small text-muted mb-2">Course: <strong id="batchModalCourseTitle"></strong></p>
                <form id="createBatchForm" class="row g-2 p-3 bg-light rounded border mb-3">
                    <input type="hidden" id="batchCourseId" />
                    <div class="col-md-4"><label class="small fw-semibold">Batch Name *</label><input type="text" class="form-control form-control-sm" id="batchNameInput" placeholder="e.g. Batch 01" required /></div>
                    <div class="col-md-3"><label class="small fw-semibold">Batch Code *</label><input type="text" class="form-control form-control-sm" id="batchCodeInput" placeholder="e.g. B01" required /></div>
                    <div class="col-md-5"><label class="small fw-semibold">Schedule</label><input type="text" class="form-control form-control-sm" id="batchScheduleInput" placeholder="Sun/Tue 10:00 AM" /></div>
                    <div class="col-md-3"><label class="small fw-semibold">Start Date *</label><input type="date" class="form-control form-control-sm" id="batchStartDate" required /></div>
                    <div class="col-md-3"><label class="small fw-semibold">End Date *</label><input type="date" class="form-control form-control-sm" id="batchEndDate" required /></div>
                    <div class="col-md-6">
                        <label class="small fw-semibold">Assign Teacher(s)</label>
                        <select id="batchTeacherIdsSelect" class="form-select form-select-sm" multiple size="2"></select>
                    </div>
                    <div class="col-12 text-end"><button type="submit" class="btn btn-primary btn-sm">+ Create Batch</button></div>
                </form>
                <div id="courseBatchesList"></div>
            </div>
        </div>
    </div>
</div>

<!-- Assign Teacher Modal -->
<div class="modal fade" id="assignTeacherModal" tabindex="-1" aria-labelledby="assignTeacherModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="assignTeacherForm" novalidate>
                <input type="hidden" id="assignTeacherCourseId" />
                <div class="modal-header">
                    <h2 class="modal-title h5 fw-bold" id="assignTeacherModalLabel">Assign Teacher to Course</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="assignTeacherFormError" class="alert alert-danger d-none"></div>
                    <p class="small text-muted">Course: <strong id="assignTeacherCourseTitle"></strong></p>
                    <div class="mb-2">
                        <label for="assignTeacherSelect" class="form-label">Select Teacher *</label>
                        <select class="form-select" id="assignTeacherSelect"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Assign Teacher</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Assign Students Modal -->
<div class="modal fade" id="assignStudentsModal" tabindex="-1" aria-labelledby="assignStudentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="assignStudentsForm" novalidate>
                <input type="hidden" id="assignStudentsCourseId" />
                <div class="modal-header">
                    <h2 class="modal-title h5 fw-bold" id="assignStudentsModalLabel">Assign Students to Course</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="assignStudentsFormError" class="alert alert-danger d-none"></div>
                    <p class="small text-muted mb-3">Course: <strong id="assignStudentsCourseTitle"></strong></p>

                    <div class="row g-2 align-items-end mb-3 p-3 bg-light rounded">
                        <div class="col-md-4">
                            <label for="enrollBatchInput" class="form-label small fw-semibold">Enroll by Batch (Optional)</label>
                            <input type="text" class="form-control form-control-sm" id="enrollBatchInput" placeholder="e.g. 70" />
                        </div>
                        <div class="col-md-4">
                            <label for="enrollSectionSelect" class="form-label small fw-semibold">Section</label>
                            <select class="form-select form-select-sm" id="enrollSectionSelect">
                                <option value="">All Sections in Batch</option>
                                <option value="A">Section A</option>
                                <option value="B">Section B</option>
                                <option value="C">Section C</option>
                                <option value="D">Section D</option>
                            </select>
                        </div>
                        <div class="col-md-4 small text-muted">
                            Leave batch empty to select individual students below.
                        </div>
                    </div>

                    <div class="mb-2">
                        <input type="search" id="enrollStudentSearch" class="form-control form-control-sm" placeholder="Filter students by ID, name, or email..." />
                    </div>
                    <div id="enrollStudentsList" class="border rounded p-2" style="max-height: 260px; overflow-y: auto;"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Assign Students</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-users.js" asp-append-version="true"></script>
    <script src="~/js/admin-courses.js" asp-append-version="true"></script>
    <script src="~/js/admin-analytics.js" asp-append-version="true"></script>
}
