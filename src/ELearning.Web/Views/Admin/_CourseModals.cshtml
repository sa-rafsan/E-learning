<!-- Edit Course Modal -->
<div class="modal fade" id="editCourseModal" tabindex="-1" aria-labelledby="editCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <form id="editCourseForm" novalidate>
                <input type="hidden" id="editCourseId" />
                <div class="modal-header bg-light border-bottom">
                    <div>
                        <h2 class="modal-title h5 fw-bold mb-0" id="editCourseModalLabel">Edit Course</h2>
                        <div class="small text-muted">Update course details, duration, and instructor</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="editCourseFormError" class="alert alert-danger d-none"></div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label for="editCourseTitle" class="form-label small fw-semibold">Course Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editCourseTitle" />
                            <div class="invalid-feedback" id="editCourseTitleError"></div>
                        </div>
                        <div class="col-md-4">
                            <label for="editCourseCode" class="form-label small fw-semibold">Course Code</label>
                            <input type="text" class="form-control" id="editCourseCode" placeholder="e.g. CS-101" />
                        </div>
                        <div class="col-md-4">
                            <label for="editCourseCategory" class="form-label small fw-semibold">Category <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editCourseCategory" />
                            <div class="invalid-feedback" id="editCourseCategoryError"></div>
                        </div>
                        <div class="col-md-4">
                            <label for="editCourseDurationWeeks" class="form-label small fw-semibold">Duration (Weeks)</label>
                            <input type="number" class="form-control" id="editCourseDurationWeeks" min="1" value="12" />
                        </div>
                        <div class="col-md-4">
                            <label for="editCourseDurationHours" class="form-label small fw-semibold">Duration (Hours) <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="editCourseDurationHours" min="1" value="12" />
                            <div class="invalid-feedback" id="editCourseDurationHoursError"></div>
                        </div>
                        <div class="col-md-12">
                            <label for="editCourseTeacher" class="form-label small fw-semibold">Primary Teacher</label>
                            <select class="form-select" id="editCourseTeacher">
                                <option value="">-- Assign Later --</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label for="editCourseDescription" class="form-label small fw-semibold">Description <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="editCourseDescription" rows="3"></textarea>
                            <div class="invalid-feedback" id="editCourseDescriptionError"></div>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="editCourseIsPublished" />
                                <label class="form-check-label small fw-semibold" for="editCourseIsPublished">Published (visible to enrolled students)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Manage Course Modal -->
<div class="modal fade" id="manageCourseModal" tabindex="-1" aria-labelledby="manageCourseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-light border-bottom">
                <div>
                    <h2 class="modal-title h5 fw-bold mb-0" id="manageCourseModalLabel">Manage Course: <span id="manageCourseTitle" class="text-primary"></span></h2>
                    <div class="small text-muted">Assign Teachers &amp; Students to Batch(es) and manage Batches</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="#" id="manageCourseWorkspaceLink" class="btn btn-sm btn-outline-success">Open Course Workspace</a>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="manageCourseId" />
                <div id="manageCourseAlert"></div>

                <div class="card border">
                    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
                        <div>
                            <h3 class="h6 fw-bold mb-0">Batch-Wise Teacher &amp; Student Workspace</h3>
                            <div class="small text-muted">Select Teacher, Batch(es), Section(s), and Students, then click Create Batch</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-primary-subtle text-primary px-3 py-2" id="manageRunningBatchesCount">0 running</span>
                            <input type="text" class="form-control form-control-sm" id="manageGroupNameInput" placeholder="Group / Session Name (e.g. Fall 2026)" style="width: 220px;" />
                        </div>
                    </div>
                    <div style="overflow: visible;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width: 190px;">Teacher</th>
                                    <th style="min-width: 190px;">Batch(es)</th>
                                    <th style="min-width: 170px;">Section(s)</th>
                                    <th style="min-width: 240px;">Students (Search &amp; Select)</th>
                                </tr>
                            </thead>
                            <tbody id="manageAssignmentRowsBody">
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted small">Loading...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="card-body border-top bg-light">
                        <div class="fw-semibold small mb-2">Create / Edit Batch</div>
                        <form id="manageCreateBatchForm" class="row g-2 align-items-end">
                            <input type="hidden" id="manageEditCourseBatchId" />
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold mb-1">Batch Name *</label>
                                <input type="text" class="form-control form-control-sm" id="manageBatchNameInput" placeholder="e.g. Batch 01" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold mb-1">Batch Code *</label>
                                <input type="text" class="form-control form-control-sm" id="manageBatchCodeInput" placeholder="e.g. B01" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-semibold mb-1">Schedule</label>
                                <input type="text" class="form-control form-control-sm" id="manageBatchScheduleInput" placeholder="Sun/Tue 10:00 AM" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold mb-1">Start Date *</label>
                                <input type="date" class="form-control form-control-sm" id="manageBatchStartDate" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-semibold mb-1">End Date *</label>
                                <input type="date" class="form-control form-control-sm" id="manageBatchEndDate" required />
                            </div>
                            <div class="col-12 text-end mt-2 d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="manageCancelEditBatchBtn">Cancel Edit</button>
                                <button type="submit" class="btn btn-sm btn-dark" id="manageCreateBatchSubmitBtn">+ Create Batch</button>
                            </div>
                        </form>
                    </div>
                    <div class="table-responsive border-top">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Batch Name</th>
                                    <th>Code</th>
                                    <th>Schedule</th>
                                    <th>Dates</th>
                                    <th>Teachers</th>
                                    <th>Enrolled</th>
                                    <th class="text-end">Workspace</th>
                                </tr>
                            </thead>
                            <tbody id="manageBatchesTableBody">
                                <tr>
                                    <td colspan="7" class="text-center py-3 text-muted small">Loading batches...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-top">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

