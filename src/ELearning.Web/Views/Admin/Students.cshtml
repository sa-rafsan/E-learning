@{
    ViewData["Title"] = "Students";
    ViewData["HideChrome"] = true;
    ViewData["ActiveMenu"] = "Students";
}

<div class="admin-shell">
    @await Html.PartialAsync("_AdminSidebar")

    <div class="admin-main">
        @await Html.PartialAsync("_AdminTopbar")

        <div class="p-3 p-md-4">
            <div id="adminAlertContainer" class="mb-3"></div>
            <div class="user-table-card p-3 p-md-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-0">Student List</h2>
                        <p class="text-muted small mb-0">Manage student accounts, enrollment, and credentials.</p>
                    </div>
                    <a href="/Admin/StudentForm" class="btn btn-primary btn-sm">+ Add Student</a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Student Details</th>
                                <th>Role &amp; Department</th>
                                <th>Contact Info</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody">
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Loading students...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-users.js" asp-append-version="true"></script>
}

