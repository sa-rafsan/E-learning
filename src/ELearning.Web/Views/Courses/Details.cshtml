@model CourseDetailDto
@{
    ViewData["Title"] = Model.Title;
}

<a class="back-link" asp-controller="Courses" asp-action="Index">&larr; Back to courses</a>

<section class="course-detail-hero">
    <div class="course-detail-copy">
        <p class="eyebrow">@Model.Category <span class="eyebrow-divider">/</span> @Model.DurationHours hours</p>
        <h1>@Model.Title</h1>
        <p class="detail-description">@Model.Description</p>
        <p class="instructor-line">Created by <strong>@Model.Instructor</strong></p>
    </div>
    <div class="detail-art" aria-hidden="true">
        <span class="detail-art-label">A COURSE FOR YOUR NEXT CHAPTER</span>
        <span class="detail-art-number">@Model.Lessons.Count.ToString("00")</span>
        <span class="detail-art-caption">lessons<br />to explore</span>
    </div>
</section>

<section class="lesson-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow">The course outline</p>
            <h2>What you'll learn.</h2>
        </div>
        <span class="lesson-total">@Model.Lessons.Count lessons</span>
    </div>

    @if (Model.Lessons.Count == 0)
    {
        <p class="empty-state">Lessons for this course are being prepared.</p>
    }
    else
    {
        <ol class="lesson-list">
            @foreach (var lesson in Model.Lessons)
            {
                <li class="lesson-row">
                    <span class="lesson-number">@lesson.Order.ToString("00")</span>
                    <div class="lesson-copy">
                        <h3>@lesson.Title</h3>
                        <p>@lesson.Summary</p>
                    </div>
                    <span class="lesson-duration">@lesson.DurationMinutes min</span>
                </li>
            }
        </ol>
    }
</section>
