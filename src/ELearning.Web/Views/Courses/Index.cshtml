@using System.Security.Claims
@model IReadOnlyList<CourseSummaryDto>
@{
    var isStudent = User.IsInRole("Student");
    ViewData["Title"] = isStudent ? "My Courses" : "Course catalog";
    if (isStudent)
    {
        ViewData["HideChrome"] = true;
    }
    var searchTerm = ViewData["SearchTerm"] as string;
}

@if (isStudent)
{
    var fullName = User.Identity?.Name ?? "Student";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? string.Empty;
    var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length >= 2
        ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
        : fullName[..Math.Min(2, fullName.Length)].ToUpperInvariant();

    <div class="admin-shell">
        <aside class="admin-sidebar">
            <div>
                <div class="admin-sidebar-brand">
                    <span class="admin-brand-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
                            <path d="M6 12v5c3 3 9 3 12 0v-5" />
                        </svg>
                    </span>
                    <div>
                        <div class="fw-bold lh-sm text-white">E-Learning</div>
                        <div class="small text-secondary lh-sm" style="font-size: 0.75rem;">Student Portal</div>
                    </div>
                </div>
                <div class="admin-nav-label">MAIN MENU</div>
                <ul class="admin-nav-list">
                    <li class="admin-nav-item"><a href="/Student/Dashboard" class="admin-nav-link text-decoration-none"><span>Dashboard</span></a></li>
                    <li class="admin-nav-item"><a href="/Student/Attendance" class="admin-nav-link text-decoration-none"><span>My Attendance</span></a></li>
                    <li class="admin-nav-item"><a href="/Courses/Index" class="admin-nav-link active text-decoration-none"><span>My Courses</span></a></li>
                    <li class="admin-nav-item"><a href="/Account/Profile" class="admin-nav-link text-decoration-none"><span>My Profile &amp; Password</span></a></li>
                </ul>
            </div>
            <div class="admin-sidebar-footer">
                <div class="admin-user-pill">
                    <span class="admin-avatar">@initials</span>
                    <div class="min-w-0 flex-grow-1">
                        <div class="small fw-semibold text-white text-truncate">@fullName</div>
                        <div class="text-info text-truncate" style="font-size: 0.72rem;">@email</div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-sm btn-link text-secondary p-0" title="Sign Out" aria-label="Sign Out">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <div class="admin-main">
            <header class="admin-topbar">
                <div>
                    <h1 class="h4 fw-bold mb-0 text-dark">My Enrolled Courses</h1>
                    <p class="text-muted small mb-0">Courses assigned to you</p>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="admin-pill-badge">Term: 2026-2027</span>
                    <span class="admin-pill-badge">Student</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Sign Out</button>
                    </form>
                </div>
            </header>

            <div class="p-3 p-md-4">
                @if (Model.Count == 0)
                {
                    <div class="user-table-card p-4 text-center text-muted">No courses assigned to you yet.</div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var course in Model)
                        {
                            var imgMap = ViewData["CourseImages"] as Dictionary<int, string?>;
                            var imgPath = imgMap != null && imgMap.TryGetValue(course.Id, out var p) ? p : null;
                            <div class="col-md-6 col-xl-4">
                                <a href="/Workspace/Course/@course.Id" class="user-table-card p-0 h-100 d-flex flex-column justify-content-between text-decoration-none text-dark overflow-hidden" style="transition: transform 0.15s ease;">
                                    @if (!string.IsNullOrWhiteSpace(imgPath))
                                    {
                                        <img src="@imgPath" alt="@course.Title" class="w-100 object-fit-cover border-bottom" style="height: 150px;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light d-flex align-items-center justify-content-center border-bottom" style="height: 150px; background: linear-gradient(135deg, #e0e7ff 0%, #dbeafe 100%);">
                                            <span class="fw-bold text-primary fs-5 px-3 text-center">@course.Category</span>
                                        </div>
                                    }
                                    <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
                                        <div>
                                            <span class="badge bg-info-subtle text-info-emphasis mb-2">@course.Category</span>
                                            <h2 class="h6 fw-bold mb-1">@course.Title</h2>
                                            <p class="small text-muted mb-2">@course.Description</p>
                                        </div>
                                        <div class="pt-2 border-top small text-muted">
                                            @course.Instructor
                                        </div>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}
else
{
    <section class="catalog-header">
        <p class="eyebrow">The course catalog</p>
        <h1>Follow your <span>curiosity.</span></h1>
        <p class="catalog-intro">Explore practical, focused courses created to help you make your next move.</p>
    </section>

    <form class="search-form" asp-controller="Courses" asp-action="Index" method="get" role="search">
        <label class="visually-hidden" for="course-search">Search courses</label>
        <input id="course-search" type="search" name="search" value="@searchTerm" placeholder="Search by topic, instructor, or skill" />
        <button class="button button-dark" type="submit">Search</button>
    </form>

    <div class="catalog-meta">
        <span>@Model.Count @(Model.Count == 1 ? "course" : "courses")</span>
        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <a class="text-link" asp-controller="Courses" asp-action="Index">Clear search</a>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <h2>No courses found</h2>
            <p>Try a different search, or clear it to explore the full catalog.</p>
        </div>
    }
    else
    {
        <div class="course-grid catalog-grid">
            @foreach (var course in Model)
            {
                <partial name="_CourseCard" model="course" />
            }
        </div>
    }
}
